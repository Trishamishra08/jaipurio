{
  "name": "jaipurio",
  "private": true,
  "version": "1.0.0",
  "description": "jaipurio marketplace monorepo",
  "scripts": {
    "postinstall": "npm install --prefix backend --omit=dev",
    "dev": "node init && npm run dev --prefix frontend",
    "build": "node init && npm install --prefix backend --omit=dev",
    "start": "node init && npm start --prefix backend",
    "preview": "npm run preview --prefix frontend",
    "backend": "npm start --prefix backend",
    "frontend": "npm run dev --prefix frontend"
  },
  "engines": {
    "node": ">=18"
  }
}
