{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "framework": null,
  "rewrites": [
    { "source": "/robots.txt", "destination": "https://jaipurio-ysbo.onrender.com/robots.txt" },
    { "source": "/sitemap.xml", "destination": "https://jaipurio-ysbo.onrender.com/sitemap.xml" },
    { "source": "/sitemap-:name.xml", "destination": "https://jaipurio-ysbo.onrender.com/sitemap-:name.xml" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "build": {
    "env": {
      "VITE_API_URL": "https://jaipurio-ysbo.onrender.com/api",
      "VITE_API_BASE_URL": "https://jaipurio-ysbo.onrender.com",
      "VITE_SITE_URL": "https://jaipurio-one.vercel.app"
    }
  }
}
